# Local overrides (optional). Prefer editing appsettings.Development.json.

# Gmail: enable IMAP, create an App Password (Google Account → Security → App passwords).
# Mail__EmailAddress=you@gmail.com
# Mail__EmailPassword=your-16-char-app-password
# Mail__DryRun=true

# OpenRouter: https://openrouter.ai/keys
# OpenRouter__ApiKey=sk-or-v1-...
